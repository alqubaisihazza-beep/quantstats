# Copy to .env and fill in. .env is gitignored.
# Interactive Brokers (TWS / IB Gateway). 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=
# Live order placement is blocked unless this is set to 1 AND dry_run is false.
QUANTETF_ALLOW_LIVE=0
# Optional: alternate config path
# QUANTETF_CONFIG=config.yaml
